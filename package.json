{
  "name": "mix-engine",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "MIX Engine — AI-Native, text-first 3D open-world urban game engine",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:runtime": "vite build --config vite.runtime.config.ts",
    "build:all": "npm run build && npm run build:runtime",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:perf": "node scripts/check-perf-budgets.mjs",
    "check:bundle": "node scripts/check-bundle-budgets.mjs",
    "check:budgets": "node scripts/check-perf-budgets.mjs && node scripts/check-bundle-budgets.mjs",
    "gen-typings": "node scripts/gen-typings.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.19.21",
    "@types/three": "^0.170.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
